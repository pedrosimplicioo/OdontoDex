{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/page.html",
      "has": [{"type": "host", "value": "www.odontodex.com.br"}]
    },
    {
      "source": "/(.*)",
      "destination": "/index.html",
      "has": [{"type": "host", "value": "app.odontodex.com.br"}]
    },
    {
      "source": "/(.*)",
      "destination": "/adm.html",
      "has": [{"type": "host", "value": "adm.odontodex.com.br"}]
    }
  ]
}
