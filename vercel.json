{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/(logo192\\.png|logo512\\.png|logolanding\\.png|manifest\\.json|sw\\.js)",
      "dest": "/$1",
      "has": [{"type": "host", "value": "landing.odontodex.com.br"}]
    },
    {
      "src": "/(.*)",
      "dest": "/page.html",
      "has": [{"type": "host", "value": "landing.odontodex.com.br"}]
    },
    {
      "src": "/src/(.*)",
      "dest": "/src/$1",
      "has": [{"type": "host", "value": "adm.odontodex.com.br"}]
    },
    {
      "src": "/(.*)",
      "dest": "/adm.html",
      "has": [{"type": "host", "value": "adm.odontodex.com.br"}]
    },
    {
      "src": "/termos",
      "dest": "/termos.html"
    },
    {
      "src": "/privacidade",
      "dest": "/privacidade.html"
    },
    {
      "src": "/exclusao-conta",
      "dest": "/exclusao-conta.html"
    }
  ]
}
